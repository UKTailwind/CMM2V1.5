diff --git a/src/ESPectrum.cpp b/src/ESPectrum.cpp
index 35d86a5..788cfb2 100644
--- a/src/ESPectrum.cpp
+++ b/src/ESPectrum.cpp
@@ -824,6 +824,10 @@ void ESPectrum::setup() {
     // RP2040: page 0 goes to external backing to save heap for framebuffer.
     // Actual data location at access time is chosen by psram_size() check in
     // mem_desc_t ops, so label the page with its real backing for honest stats.
+#ifdef CMM2_APP
+    MemESP::ram[0].assign_ram(new unsigned char[MEM_PG_SZ], 0, false);   // (the CMM2 has the room)
+    ++ram_pages;
+#else
     if (psram_size() >= MEM_PG_SZ) {
         MemESP::ram[0].assign_vram(0, mem_type_t::PSRAM_SPI);
         ++psram_pages;
@@ -831,6 +835,7 @@ void ESPectrum::setup() {
         MemESP::ram[0].assign_vram(0, mem_type_t::SWAP);
         ++swap_pages;
     }
+#endif
     MemESP::ram[1].assign_ram(new unsigned char[MEM_PG_SZ], 1, false);
     MemESP::ram[2].assign_ram(new unsigned char[MEM_PG_SZ], 2, false);
     MemESP::ram[3].assign_ram(new unsigned char[MEM_PG_SZ], 3, false);
diff --git a/src/MemESP.h b/src/MemESP.h
index bcc48e2..f99209a 100644
--- a/src/MemESP.h
+++ b/src/MemESP.h
@@ -47,6 +47,14 @@ visit https://zxespectrum.speccy.org/contacto
 #include "ChipPackage.h"
 
 #define MEM_PG_SZ 0x4000
+#ifdef CMM2_APP
+// The CMM2 runs the program from RAM, far above the PSRAM's address, so nothing there is below it and a ROM
+// would take the Z80's writes. A ROM is what the linker put in the image's read-only part.
+extern "C" char __image_start[], __fini_array_end[];
+#define MEM_IS_ROM(p) ((char *)(p) >= __image_start && (char *)(p) < __fini_array_end)
+#else
+#define MEM_IS_ROM(p) ((uint8_t *)(p) < (uint8_t *)0x11000000)
+#endif
 #if PICO_RP2350
 // with gigascreen
 #define MEM_REMAIN (14*16*1024)
@@ -490,7 +498,7 @@ inline void MemESP::writebyte(uint16_t addr, uint8_t data)
         accessorWrite(page, addr & 0x3fff, data);
         return;
     }
-    if (p < (uint8_t*)0x11000000) return;
+    if (MEM_IS_ROM(p)) return;
     *mem_desc_t::bank_dirty[page] = true;
 #if MEM_ACCESS_TRACE
     *mem_desc_t::bank_access[page] += 1;
