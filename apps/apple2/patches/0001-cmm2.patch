diff --git a/src/mii_dd_stub.c b/src/mii_dd_stub.c
index 802be87..81f36dd 100644
--- a/src/mii_dd_stub.c
+++ b/src/mii_dd_stub.c
@@ -126,6 +126,11 @@ mii_dd_file_load(
 			mii_dd_files[flags].size = (PRODOS_MAX_BLOCKS * PRODOS_BLOCK_SIZE); // W/A ~32 MB
 		}
 	} else {
+#ifdef CMM2_APP
+		// the CMM2: a hard disk only if its image is on the card, not a 32 MB one made for it
+		mii_dd_files[flags].read_only = true;
+		mii_dd_files[flags].size = 0;
+#else
 		mii_dd_files[flags].read_only = false;
 		mii_dd_files[flags].size = (PRODOS_MAX_BLOCKS * PRODOS_BLOCK_SIZE); // W/A ~32 MB
 		f_open(f, pathname, FA_WRITE | FA_OPEN_ALWAYS);
@@ -133,6 +138,7 @@ mii_dd_file_load(
 		UINT bw;
 		uint8_t zero = 0;
 		f_write(f, &zero, 1, &bw);
+#endif
 	}
 	mii_dd_files[flags].drive_idx = flags; // reuse flags as drive idx
 	return &mii_dd_files[flags];
