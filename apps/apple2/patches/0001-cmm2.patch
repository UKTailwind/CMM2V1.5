diff --git a/drivers/psram_allocator.h b/drivers/psram_allocator.h
index 3ba7b8c..c3b5a8d 100644
--- a/drivers/psram_allocator.h
+++ b/drivers/psram_allocator.h
@@ -8,7 +8,13 @@
 #ifndef MURM_PSRAM_SIZE_BYTES
 #define MURM_PSRAM_SIZE_BYTES (8u * 1024u * 1024u)
 #endif
+#ifdef CMM2_APP
+#include <stdint.h>
+extern uint8_t *cmm2_psram;   // the CMM2: no PSRAM, a block of its heap (apps/apple2/apple_cmm2.c)
+#define PSRAM_DATA cmm2_psram
+#else
 #define PSRAM_DATA ((uint8_t*)(intptr_t)0x11000000)
+#endif
 
 void *psram_malloc(size_t size);
 void *psram_realloc(void *ptr, size_t size);
diff --git a/src/disk_loader.c b/src/disk_loader.c
index a978870..e525958 100644
--- a/src/disk_loader.c
+++ b/src/disk_loader.c
@@ -25,9 +25,16 @@
 #include "debug_log.h"
 
 // Global state
+#ifdef CMM2_APP
+// the CMM2: a list of its own, so that the Apple's memory is not borrowed for it (and saved to the card and back, disk_ui.c)
+#define MAX_DISK_IMAGES 1024
+static disk_entry_t disk_list[MAX_DISK_IMAGES];
+disk_entry_t* g_disk_list = disk_list;
+#else
 extern uint8_t vram[2 * RAM_PAGES_PER_POOL * RAM_PAGE_SIZE];
 #define MAX_DISK_IMAGES (sizeof(vram) / sizeof(disk_entry_t))
 disk_entry_t* g_disk_list = (disk_entry_t*)vram;//[MAX_DISK_IMAGES];
+#endif
 
 #if PICO_RP2350
 // drive0_cache lives in PSRAM to save 228KB of SRAM.
@@ -614,7 +621,9 @@ int disk_loader_init(void) {
         printf("SD card mount failed: %d\n", fr);
         return -1;
     }
+#ifndef CMM2_APP // (the CMM2: nothing goes in /tmp, which would be a folder in the disk menu)
     f_mkdir("/tmp");
+#endif
     f_mkdir("/apple");
     /// TODO: is log
     f_unlink("/apple.log");
