From: CMM2 port <noreply@example.invalid>
Subject: framebuffer: FreeType faces read whole into memory on the CMM2

On the Colour Maximite 2 (apps/browser, __CMM2__) a program may have only eight files open, and FreeType's cache
manager would keep one open for each face it holds. A face's file is read into memory when the face is first used and
closed at once (FT_Open_Face on a stream whose close frees the memory); the memory is the display memory lent to the
browser when there is room (cmm2_malloc_pool, apps/browser/port/browser_malloc.c). At start-up the files are only
looked for, and the cache keeps every face. Everywhere: fb_new_face no longer copies an unset buffer when
filepath_sfind finds nothing, and checks calloc.
---
diff --git a/frontends/framebuffer/font_freetype.c b/frontends/framebuffer/font_freetype.c
index 3912821..2a1d527 100644
--- a/frontends/framebuffer/font_freetype.c
+++ b/frontends/framebuffer/font_freetype.c
@@ -75,6 +75,59 @@ enum fb_face_e {
 
 static fb_faceid_t *fb_faces[FB_FACE_COUNT];
 
+#ifdef __CMM2__
+/* The Colour Maximite 2 (apps/browser): a face's file is read into memory whole and closed at once. A program there
+ * may have only eight files open, and the cache manager would keep a file open for each face it holds; reading a
+ * glyph from memory is also much quicker than seeking on the SD card (28 Nov 2026: a face read from its file as
+ * FreeType asked was very slow). The memory is the display memory lent to the browser when there is room
+ * (cmm2_malloc_pool, apps/browser/port/browser_malloc.c), so that the faces leave the main heap to the pages (Peter,
+ * 28 Nov 2026). FreeType frees it when it closes the face, through the stream's close (FT_Stream_Free, after the
+ * driver is done with the face). */
+void *cmm2_malloc_pool(size_t n);
+
+static void fb_stream_close(FT_Stream stream)
+{
+	free(stream->base);
+	free(stream);
+}
+
+static FT_Error
+fb_open_face(FT_Library library, const char *path, FT_Long index, FT_Face *face)
+{
+	FT_Open_Args args;
+	FT_Stream stream;
+	unsigned char *data = NULL;
+	long size = -1;
+	FILE *f;
+
+	f = fopen(path, "rb");
+	if (f == NULL)
+		return FT_Err_Cannot_Open_Resource;
+	if (fseek(f, 0, SEEK_END) == 0)
+		size = ftell(f);
+	if (size > 0 && fseek(f, 0, SEEK_SET) == 0 && (data = cmm2_malloc_pool(size)) != NULL &&
+	    fread(data, 1, size, f) != (size_t)size) {
+		free(data);
+		data = NULL;
+	}
+	fclose(f);
+	if (data == NULL)
+		return size > 0 ? FT_Err_Out_Of_Memory : FT_Err_Cannot_Open_Stream;
+
+	stream = calloc(1, sizeof(*stream));
+	if (stream == NULL) {
+		free(data);
+		return FT_Err_Out_Of_Memory;
+	}
+	stream->base = data;
+	stream->size = size;
+	stream->close = fb_stream_close;
+	args.flags = FT_OPEN_STREAM;
+	args.stream = stream;
+	return FT_Open_Face(library, &args, index, face); /* (the stream closed by FreeType if this fails) */
+}
+#endif
+
 /**
  * map cache manager handle to face id
  */
@@ -88,7 +141,11 @@ ft_face_requester(FTC_FaceID face_id,
         fb_faceid_t *fb_face = (fb_faceid_t *)face_id;
         int cidx;
 
-        error = FT_New_Face(library, fb_face->fontfile, fb_face->index, face); 
+#ifdef __CMM2__
+        error = fb_open_face(library, fb_face->fontfile, fb_face->index, face);
+#else
+        error = FT_New_Face(library, fb_face->fontfile, fb_face->index, face);
+#endif
         if (error) {
                 NSLOG(netsurf, INFO, "Could not find font (code %d)", error);
         } else {
@@ -123,15 +180,32 @@ fb_new_face(const char *option, const char *resname, const char *fontname)
 	char buf[PATH_MAX];
 
         newf = calloc(1, sizeof(fb_faceid_t));
+        if (newf == NULL)
+                return NULL;
 
         if (option != NULL) {
                 newf->fontfile = strdup(option);
-        } else {
-		filepath_sfind(respaths, buf, fontname);
+        } else if (filepath_sfind(respaths, buf, fontname) != NULL) {
                 newf->fontfile = strdup(buf);
+        } else {
+                /* (not found: buf is not set) */
+                free(newf);
+                return NULL;
         }
 
+#ifdef __CMM2__
+        /* only that the file is there: its face is read when it is first
+         * used (fb_open_face), as most pages use few of the faces */
+        {
+                FILE *f = fopen(newf->fontfile, "rb");
+                error = (f != NULL) ? FT_Err_Ok : FT_Err_Cannot_Open_Resource;
+                if (f != NULL)
+                        fclose(f);
+                (void)aface;
+        }
+#else
         error = FTC_Manager_LookupFace(ft_cmanager, (FTC_FaceID)newf, &aface);
+#endif
         if (error) {
                 NSLOG(netsurf, INFO, "Could not find font face %s (code %d)",
                       fontname, error);
@@ -148,7 +222,11 @@ bool fb_font_init(void)
 {
         FT_Error error;
         FT_ULong max_cache_size;
+#ifdef __CMM2__
+        FT_UInt max_faces = FB_FACE_COUNT; /* (each held in memory: none read again) */
+#else
         FT_UInt max_faces = 6;
+#endif
 	fb_faceid_t *fb_face;
 
         /* freetype library initialise */
