+/**
+ * A page the window gave up, closed and released and the cache cleaned (the
+ * Colour Maximite 2's, patches/netsurf-0005), from the main loop and not at
+ * once: a navigation often comes from inside that page's own code (a link's
+ * click, in its mouse action), which goes on with it after navigating (28 Nov
+ * 2026: destroyed at once, the heap was damaged).
+ */
+static void browser_window_drop_page(void *p)
+{
+	hlcache_handle *c = p;
+
+	content_close(c);
+	hlcache_handle_release(c);
+	hlcache_clean_now();
+}
+
+/**
+ * The callback of a page the window gave up, until it is dropped: what it
+ * still says (an image of it finishing, say) no longer goes to the window
+ */
+static nserror browser_window_dropped_callback(hlcache_handle *handle,
+		const hlcache_event *event, void *pw)
+{
+	(void)handle;
+	(void)event;
+	(void)pw;
+	return NSERROR_OK;
+}
+
+/**
+ * The Colour Maximite 2's (apps/browser, patches/netsurf-0005; Peter, 28 Nov
+ * 2026): one page in memory at a time. The page shown was kept until the next
+ * was ready, and the cache kept it for up to 20 s after, so two pages were
+ * built side by side: a Wikipedia page takes up to 19 MB of the browser's 20.
+ * So the window gives up the page shown when the next one's content has been
+ * made (CONTENT_MSG_LOADING: its type is known, and none of its data has been
+ * read), and the page is closed, released and the cache cleaned from the main
+ * loop (browser_window_drop_page). Until then the page stays: a link that
+ * turns out to be a download, or that fails, leaves it as it was (it was given
+ * up at the navigation at first, and a download left the window blank). The
+ * window is blank from then until the next page is ready, and Back fetches a
+ * page again (from the memory cache, or the network); its scroll position is
+ * kept in the history. Frames are left as they were.
+ */
+static void browser_window_give_up_page(struct browser_window *bw)
+{
+	if (bw->parent == NULL && bw->current_content != NULL) {
+		hlcache_handle *old = bw->current_content;
+		bw->current_content = NULL;
+		hlcache_handle_replace_callback(old,
+				browser_window_dropped_callback, NULL);
+		guit->misc->schedule(0, browser_window_drop_page, old);
+		if (bw->window != NULL) {
+			guit->window->invalidate(bw->window, NULL);
+		}
+	}
+}
