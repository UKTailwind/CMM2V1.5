+/* (hlcache_clean_now's work, also scheduled by hlcache_clean_soon) */
+static void hlcache_clean_forced(void *p)
+{
+	static int force = 1;
+
+	(void)p;
+	/* forced: a page stopped while loading still counts as loading,
+	 * which the cleaner otherwise leaves until the browser ends; twice:
+	 * destroying a page gives up the images it held, which the second
+	 * pass then destroys (each pass reschedules the cleaner, which the
+	 * scheduler keeps unique) */
+	hlcache_clean(&force);
+	hlcache_clean(&force);
+}
+
+/* See hlcache.h for documentation */
+void hlcache_clean_now(void)
+{
+	hlcache_clean_forced(NULL);
+}
+
+/* See hlcache.h for documentation */
+void hlcache_clean_soon(void)
+{
+	guit->misc->schedule(0, hlcache_clean_forced, NULL);
+}
+
