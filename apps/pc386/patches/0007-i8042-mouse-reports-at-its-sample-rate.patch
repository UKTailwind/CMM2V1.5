diff --git a/i8042.c b/i8042.c
index fbe0959..463ba84 100644
--- a/i8042.c
+++ b/i8042.c
@@ -472,6 +472,7 @@ struct PS2MouseState {
     int mouse_dy;
     int mouse_dz;
     uint8_t mouse_buttons;
+    uint32_t last_report; /* get_uticks() at the last packet sent */
 };
 
 void ps2_queue(void *opaque, int b)
@@ -870,16 +871,27 @@ void ps2_mouse_event(PS2MouseState *s,
     s->mouse_buttons = buttons_state;
 
     /* As a mouse reports at its sample rate and adds up what it moved
-       meanwhile: a packet only when the last has been read (or for a
-       change of buttons, while there is room), the rest kept for the next
-       event. A guest that reads slowly then gets the movement late but
-       whole: queued packets made it lag, and a large movement's packets
-       could overrun the queue, the bytes lost putting the packets after
-       out of step (X read as Y). */
+       meanwhile: a packet only when the last has been read and the rate
+       the guest set allows it (a tenth early, as events come at the host's
+       pace), or for a change of buttons while there is room; the rest kept
+       for the next event. A guest that reads slowly then gets the movement
+       late but whole: queued packets made it lag, and a large movement's
+       packets could overrun the queue, the bytes lost putting the packets
+       after out of step (X read as Y). The rate matters to Windows 3.1:
+       it asks for 40 a second, and its 386 enhanced mode holds 32 bytes
+       for the System VM; at 30, it drops the last byte of one packet and
+       the first two of the next, so the VM gets one packet's status with
+       the next's Y, whose sign is then the other's: the pointer leapt up
+       or down the screen while the mouse moved sideways. */
+    uint32_t now = get_uticks();
+    int rate = s->mouse_sample_rate ? s->mouse_sample_rate : 100;
     if (!(s->mouse_status & MOUSE_STATUS_REMOTE) &&
-        (s->common.queue.count == 0 ||
-         (changed && s->common.queue.count < (PS2_QUEUE_SIZE - 16))))
+        ((s->common.queue.count == 0 &&
+          now - s->last_report >= 900000u / rate) ||
+         (changed && s->common.queue.count < (PS2_QUEUE_SIZE - 16)))) {
+        s->last_report = now;
         ps2_mouse_send_packet(s);
+    }
 }
 
 void ps2_write_mouse(void *opaque, int val)
