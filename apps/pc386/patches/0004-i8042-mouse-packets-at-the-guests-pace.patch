diff --git a/i8042.c b/i8042.c
index 5718c8b..fbe0959 100644
--- a/i8042.c
+++ b/i8042.c
@@ -866,18 +866,20 @@ void ps2_mouse_event(PS2MouseState *s,
     if (s->mouse_dx == 0 && s->mouse_dy == 0 && s->mouse_dz == 0 &&
         s->mouse_buttons == buttons_state)
         return;
+    int changed = s->mouse_buttons != buttons_state;
     s->mouse_buttons = buttons_state;
 
+    /* As a mouse reports at its sample rate and adds up what it moved
+       meanwhile: a packet only when the last has been read (or for a
+       change of buttons, while there is room), the rest kept for the next
+       event. A guest that reads slowly then gets the movement late but
+       whole: queued packets made it lag, and a large movement's packets
+       could overrun the queue, the bytes lost putting the packets after
+       out of step (X read as Y). */
     if (!(s->mouse_status & MOUSE_STATUS_REMOTE) &&
-        (s->common.queue.count < (PS2_QUEUE_SIZE - 16))) {
-        for(;;) {
-            /* if not remote, send event. Multiple events are sent if
-               too big deltas */
-            ps2_mouse_send_packet(s);
-            if (s->mouse_dx == 0 && s->mouse_dy == 0 && s->mouse_dz == 0)
-                break;
-        }
-    }
+        (s->common.queue.count == 0 ||
+         (changed && s->common.queue.count < (PS2_QUEUE_SIZE - 16))))
+        ps2_mouse_send_packet(s);
 }
 
 void ps2_write_mouse(void *opaque, int val)
