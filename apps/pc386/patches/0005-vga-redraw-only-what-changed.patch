         line_bytes = 4 * ((((w - 1) / xdiv + pan) >> 3) + 1);
     else
         line_bytes = ((w - 1) / xdiv + pan + 1) * ((bpp + 7) / 8);
+    /* Only the lines whose video memory was written are drawn again,
+       unless anything else the picture is drawn from changed since the
+       last one: then all of it. */
+    uint32_t sig = 2166136261u;
+#define SIG(v) (sig = (sig ^ (uint32_t) (v)) * 16777619u)
+    SIG(w); SIG(h); SIG(i0); SIG(shift_control); SIG(xdiv); SIG(bpp);
+    SIG(addr1); SIG(line_offset); SIG(multi_scan); SIG(pan);
+    SIG(split_after); SIG(s->ar[0x10] & 0x20); SIG(s->cr[0x17]);
+    SIG(vbe); SIG(plane_mask); SIG(s->comp_ntsc);
+    int npal = shift_control <= 1 ? 16 : bpp == 8 ? 256 : 0;
+    for (int k = 0; k < npal; k++)
+        SIG(palette[k]);
+#undef SIG
+    int all = full_update || sig != s->last_sig;
+    s->last_sig = sig;
     for (int y = 0; y < h; y++) {
         uint32_t addr = addr1;
         if (!(s->cr[0x17] & 1)) {
@@ -1319,6 +1359,10 @@ static void vga_graphic_refresh(VGAState *s,
 #endif
             x0 = w;
         }
+#if !defined(SCALE_3_2) && !defined(SCALE_2_1) && !defined(SWAPXY)
+        if (!all && x0 == 0 && !vga_is_dirty(s, addr, line_bytes))
+            x0 = w;     /* as it is shown already */
+#endif
 
         uint32_t color_comp = 0;
         for (int x = x0; x < w; x++) {
@@ -1500,6 +1544,7 @@ static void vga_graphic_refresh(VGAState *s,
 #undef KLINE
 #endif
     }
+    memset(s->dirty, 0, s->dirty_words * sizeof(uint32_t));
     redraw_func(opaque, 0, 0, fb_dev->width, fb_dev->height);
 }
 
