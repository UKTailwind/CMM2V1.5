--- a/vga.c
+++ b/vga.c
@@ -137,6 +137,9 @@ struct VGAState {
     /* text mode state */
     uint32_t last_palette[16];
     int last_gw, last_gh;   /* the graphics picture's size; -1: just cleared */
+    uint32_t *dirty;        /* a bit for each 1 KB of video memory written since the last picture */
+    int dirty_words;
+    uint32_t last_sig;      /* what else the last picture was drawn from (vga_graphic_refresh) */
 #ifndef FULL_UPDATE
     uint16_t last_ch_attr[MAX_TEXT_WIDTH * MAX_TEXT_HEIGHT];
 #endif
@@ -175,6 +178,28 @@ static int after_eq(uint32_t a, uint32_t b)
     return (a - b) < (1u << 31);
 }
 
+/* video memory written: its 1 KB blocks marked, for the next picture to redraw the lines that show them */
+static inline void vga_dirty(VGAState *s, uint32_t off, uint32_t len)
+{
+    uint32_t a = off >> 10, b = (off + len - 1) >> 10;
+    for (; a <= b && (int) (a >> 5) < s->dirty_words; a++)
+        s->dirty[a >> 5] |= 1u << (a & 31);
+}
+
+void vga_mark_dirty(VGAState *s, uint32_t off, uint32_t len)
+{
+    vga_dirty(s, off, len);
+}
+
+static inline int vga_is_dirty(VGAState *s, uint32_t off, uint32_t len)
+{
+    uint32_t a = off >> 10, b = (off + len - 1) >> 10;
+    for (; a <= b && (int) (a >> 5) < s->dirty_words; a++)
+        if (s->dirty[a >> 5] & (1u << (a & 31)))
+            return 1;
+    return 0;
+}
+
 static void simplefb_clear(FBDevice *fb_dev)
 {
     memset(fb_dev->fb_data, 0, fb_dev->width * fb_dev->height * (BPP / 8));
