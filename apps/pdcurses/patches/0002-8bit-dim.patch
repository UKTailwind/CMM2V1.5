 #define SWAP_RED_AND_BLUE( rgb) (((rgb) & 0xff00) | ((rgb) >> 16) | (((rgb) & 0xff) << 16))
 
+   /* For A_DIM in the 8-bit path: the palette entry nearest the colour */
+   /* with its red, green and blue knocked down by 1/3, as the 32-bit   */
+   /* path dims (pdccolor.c).  Worked out once for each entry, and      */
+   /* again only if that entry is changed.                              */
+
+static int _dimmed_index( const int idx)
+{
+    static PACKED_RGB from[256];
+    static short to[256];            /* the answer plus 1; 0 = not yet */
+    PACKED_RGB c, d = 0;
+    long best_dist = -1;
+    int i, best = idx;
+
+    if( idx < 0 || idx > 255)
+        return( idx);
+    c = PDC_get_palette_entry( idx);
+    if( to[idx] && from[idx] == c)
+        return( to[idx] - 1);
+    for( i = 0; i < 3; i++)
+    {
+        const unsigned v = (unsigned)(( c >> (i * 8)) & 0xff);
+
+        d |= (PACKED_RGB)( v - v / 3) << (i * 8);
+    }
+    for( i = 0; i < 256; i++)
+    {
+        const PACKED_RGB e = PDC_get_palette_entry( i);
+        long dist = 0;
+        int k;
+
+        for( k = 0; k < 3; k++)
+        {
+            const long diff = (long)(( e >> (k * 8)) & 0xff)
+                            - (long)(( d >> (k * 8)) & 0xff);
+
+            dist += diff * diff;
+        }
+        if( best_dist < 0 || dist < best_dist)
+        {
+            best_dist = dist;
+            best = i;
+        }
+    }
+    from[idx] = c;
+    to[idx] = (short)( best + 1);
+    return( best);
+}
