diff --git a/external/musashi/m68kcpu.h b/external/musashi/m68kcpu.h
index a743cdb..710c2f6 100644
--- a/external/musashi/m68kcpu.h
+++ b/external/musashi/m68kcpu.h
@@ -462,8 +462,22 @@ typedef uint32 uint64;
 
 
 #if !M68K_SEPARATE_READS
+#ifdef AMIGA_FAST_FETCH
+/* CMM2: the opcode and its extension words read inline from plain memory (the
+ * memory map's banks, mem.c), not by a call to m68k_read_memory_16 each (from
+ * m68k_execute in the ITCM, through a veneer to the AXI RAM): 9% of a frame */
+#include "amiga_int.h"
+static inline unsigned amiga_fetch16(unsigned a) {
+	const amiga_bank_t *b = &amiga_banks[(a >> 16) & 0xFF];
+	if (b->rd) { uint16_t v; memcpy(&v, b->rd + (a & b->mask), 2); return __builtin_bswap16(v); }
+	return m68k_read_memory_16(a);
+}
+#define m68k_read_immediate_16(A) amiga_fetch16(A)
+#define m68k_read_immediate_32(A) ((amiga_fetch16(A) << 16) | amiga_fetch16((A) + 2))
+#else
 #define m68k_read_immediate_16(A) m68ki_read_program_16(A)
 #define m68k_read_immediate_32(A) m68ki_read_program_32(A)
+#endif
 
 #define m68k_read_pcrelative_8(A) m68ki_read_program_8(A)
 #define m68k_read_pcrelative_16(A) m68ki_read_program_16(A)
@@ -1931,7 +1945,13 @@ static inline void m68ki_exception_privilege_violation(void)
 
 extern jmp_buf m68ki_bus_error_jmp_buf;
 
+#ifdef M68K_NO_BUS_ERROR_TRAP
+/* CMM2: nothing here raises a bus error (m68k_pulse_bus_error is never called), so no setjmp at each m68k_execute:
+   the core enters it thousands of times a frame (5% of the time) */
+#define m68ki_check_bus_error_trap() 0
+#else
 #define m68ki_check_bus_error_trap() setjmp(m68ki_bus_error_jmp_buf)
+#endif
 
 /* Exception for bus error */
 static inline void m68ki_exception_bus_error(void)
