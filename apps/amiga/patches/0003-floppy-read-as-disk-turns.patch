+            chip_ww(dskpt + n * 2, track[pos]);
+            if (++pos == TRACK_WORDS) pos = 0;
+        }
+        rd_copied = upto;
+    }
+    rot_pos = (rd_pos0 + rd_copied) % TRACK_WORDS;
+}
