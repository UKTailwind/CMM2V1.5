+// The running read's words up to `upto` into chip RAM, the head after them.
+static void rd_copy(uint32_t upto) {
+    if (upto > rd_words) upto = rd_words;
+    if (upto > rd_copied) {
+        if (trk_drive != dma_drive) ensure_track(dma_drive);   // after a snapshot load
