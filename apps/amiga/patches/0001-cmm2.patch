+#ifdef AMIGA_FAST_FETCH
+// CMM2: the memory map's banks (mem.c), for Musashi's opcode and extension word
+// reads inline (m68kcpu.h's amiga_fetch16): a bank with a direct read base is
+// plain memory (chip, slow, ROM), read there as m68k_read_memory_16 would; any
+// other through it.
+#ifdef AMIGA_FAST_MEM
+typedef struct {         // (the reads' table only: 8 bytes, one indexed load; mem.c has the writes')
+    const uint8_t *rd;   // direct read base, or NULL
+    uint32_t       mask; // read offset mask applied to the full address
+} amiga_bank_t;
+#else
+typedef struct {
+    const uint8_t *rd;   // direct read base, or NULL
+    uint8_t       *wr;   // direct write base, or NULL (writes to ROM are dropped)
+    uint32_t       mask; // read offset mask applied to the full address
+    uint32_t       wmask;// write offset mask (differs from mask under the ROM overlay)
+    uint8_t        io;   // B_* when rd == NULL
+} amiga_bank_t;
+#endif
+extern amiga_bank_t amiga_banks[256];
+#endif
