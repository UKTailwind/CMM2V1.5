diff --git a/src/amiga/amiga_int.h b/src/amiga/amiga_int.h
index 4b59e2a..0e35311 100644
--- a/src/amiga/amiga_int.h
+++ b/src/amiga/amiga_int.h
@@ -159,11 +159,26 @@ bool     mem_overlay(void);
 // DMA-side chip RAM access (word address, already masked by the caller).
 // One halfword access each (the address is even): two byte accesses cost
 // twice on PSRAM.  Chip RAM is big-endian, the hosts are little-endian.
+#ifdef AMIGA_REV16
+// CMM2: a big-endian halfword by LDRH and REV16 (__builtin_bswap16 on a uint16_t
+// adds a UXTH after it; LDRH has made the top half zero, which REV16 keeps).
+static inline uint32_t amiga_be16(const uint8_t *p) {
+    uint16_t v;
+    memcpy(&v, p, 2);
+    uint32_t r;
+    __asm__("rev16 %0, %1" : "=r"(r) : "r"((uint32_t)v));
+    return r;
+}
+static inline uint32_t chip_rw(uint32_t addr) {
+    return amiga_be16(A.cfg.chip_ram + (addr & A.chip_mask & ~1u));
+}
+#else
 static inline uint16_t chip_rw(uint32_t addr) {
     uint16_t v;
     memcpy(&v, A.cfg.chip_ram + (addr & A.chip_mask & ~1u), 2);
     return __builtin_bswap16(v);
 }
+#endif
 static inline void chip_ww(uint32_t addr, uint16_t v) {
     v = __builtin_bswap16(v);
     memcpy(A.cfg.chip_ram + (addr & A.chip_mask & ~1u), &v, 2);
