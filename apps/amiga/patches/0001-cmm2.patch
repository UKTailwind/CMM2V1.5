 #define m68k_read_pcrelative_16(A) m68ki_read_program_16(A)
@@ -1931,7 +1956,13 @@ static inline void m68ki_exception_privilege_violation(void)
 
 extern jmp_buf m68ki_bus_error_jmp_buf;
 
+#ifdef M68K_NO_BUS_ERROR_TRAP
+/* CMM2: nothing here raises a bus error (m68k_pulse_bus_error is never called), so no setjmp at each m68k_execute:
+   the core enters it thousands of times a frame (5% of the time) */
+#define m68ki_check_bus_error_trap() 0
+#else
 #define m68ki_check_bus_error_trap() setjmp(m68ki_bus_error_jmp_buf)
+#endif
 
 /* Exception for bus error */
 static inline void m68ki_exception_bus_error(void)
