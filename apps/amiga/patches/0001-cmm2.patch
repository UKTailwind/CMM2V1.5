+/* CMM2: a 68000 build only, and every consumer masks again (mem.c's callbacks to
+ * 24 bits, amiga_fetch16 by its bank and mask): the load of the mask and the AND
+ * at each of the 68000's accesses dropped (about four instructions each) */
+#define ADDRESS_68K(A) (A)
+#else
 #define ADDRESS_68K(A) ((A)&CPU_ADDRESS_MASK)
+#endif
 
 
 /* Shift & Rotate Macros. */
@@ -462,8 +469,26 @@ typedef uint32 uint64;
 
 
 #if !M68K_SEPARATE_READS
+#ifdef AMIGA_FAST_FETCH
+/* CMM2: the opcode and its extension words read inline from plain memory (the
+ * memory map's banks, mem.c), not by a call to m68k_read_memory_16 each (from
+ * m68k_execute in the ITCM, through a veneer to the AXI RAM): 9% of a frame */
+#include "amiga_int.h"
+static inline unsigned amiga_fetch16(unsigned a) {
+	const amiga_bank_t *b = &amiga_banks[(a >> 16) & 0xFF];
+#ifdef AMIGA_REV16
+	if (b->rd) return amiga_be16(b->rd + (a & b->mask));
+#else
+	if (b->rd) { uint16_t v; memcpy(&v, b->rd + (a & b->mask), 2); return __builtin_bswap16(v); }
+#endif
+	return m68k_read_memory_16(a);
