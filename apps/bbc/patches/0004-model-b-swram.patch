@@ -118,7 +118,15 @@ int get_i() {
 }
 
 void m6502_init(void) {
+#ifdef CMM2_APP
+    // CMM2: the CPU's time kept across CPUInit's memset (main_restart, a change of model, inits it again): the hardware's events are timed
+    // against it, and advance_hardware asserts when it goes back
+    int32_t clk = g_cpu.clk;
     CPUInit();
+    g_cpu.clk = clk;
+#else
+    CPUInit();
+#endif
     g_cpu.memHandlers = MemMapInit();
 }
 
