diff --git a/src/frank/frank_disc.c b/src/frank/frank_disc.c
index 2b6ee70..67c9256 100644
--- a/src/frank/frank_disc.c
+++ b/src/frank/frank_disc.c
@@ -39,10 +39,12 @@ struct fatfs_drive {
     uint8_t            secdata[1024] __attribute__((aligned(4)));
     const struct sdf_geometry *geo;
     bool               have_image;
+    bool               writable;                 /* CMM2: the file opened for writing too */
     char               path[160];
 };
 
 static struct fatfs_drive s_drv[2];
+bool g_frank_disc_readonly;                      /* CMM2: the images opened for reading only (RUN's -ro) */
 
 static struct sector_buffer *fatfs_acquire(struct sector_read *sr, uint32_t sector) {
     struct fatfs_drive *d = (struct fatfs_drive *)sr;
@@ -72,6 +74,27 @@ static uint fatfs_check_available(struct sector_read *sr, struct sector_buffer *
     return buffer->buffer.size;
 }
 
+/* CMM2: a sector the BBC wrote, back to the image file and on the card at once (f_sync); an image that stops short of it (a .dsd often
+   does) first lengthened by blank sectors. data NULL asks whether the image can be written */
+static bool fatfs_write(struct sector_read *sr, uint32_t sector, const uint8_t *data) {
+    struct fatfs_drive *d = (struct fatfs_drive *)sr;
+    static const uint8_t blank[1024];
+    UINT bw;
+    if (!d->have_image || !d->writable || sector >= sr->sector_count || sr->sector_size > sizeof(blank)) return false;
+    if (!data) return true;
+    while (d->file_sectors < sector) {
+        if (f_lseek(&d->fil, (FSIZE_t)d->file_sectors * sr->sector_size) != FR_OK ||
+            f_write(&d->fil, blank, sr->sector_size, &bw) != FR_OK || bw != sr->sector_size)
+            return false;
+        d->file_sectors++;
+    }
+    if (f_lseek(&d->fil, (FSIZE_t)sector * sr->sector_size) != FR_OK ||
+        f_write(&d->fil, data, sr->sector_size, &bw) != FR_OK || bw != sr->sector_size)
+        return false;
+    if (sector >= d->file_sectors) d->file_sectors = sector + 1;
+    return f_sync(&d->fil) == FR_OK;
+}
+
 static void fatfs_close(struct sector_read *sr) {
     struct fatfs_drive *d = (struct fatfs_drive *)sr;
     if (d->have_image) {
@@ -88,6 +111,7 @@ static const struct sector_read_funcs fatfs_funcs = {
 #ifndef NDEBUG
     .type = memory,
 #endif
+    .write_sector    = fatfs_write,
 };
 
 /* Pick a DFS/ADFS geometry from the image size + extension (mirrors b-em
@@ -155,6 +179,19 @@ int frank_disc_mount(int drive, const char *path) {
     uint32_t full = (uint32_t)geo->tracks * geo->sectors_per_track * geo->sector_size;
     if (geo->sides != SDF_SIDES_SINGLE) full *= 2;
 
+    /* CMM2: opened again to be written as well (FA_OPEN_APPEND: the file is there; the loader then keeps no link map, which would stop
+       a short image being lengthened), unless -ro or it cannot be (a read-only file): then the BBC finds the disc write protected */
+    d->writable = false;
+    if (!g_frank_disc_readonly) {
+        f_close(&d->fil);
+        if (f_open(&d->fil, path, FA_READ | FA_WRITE | FA_OPEN_APPEND) == FR_OK)
+            d->writable = true;
+        else if ((fr = f_open(&d->fil, path, FA_READ)) != FR_OK) {
+            printf("DISC: open '%s' failed (%d)\n", path, (int)fr);
+            return -1;
+        }
+    }
+
     d->sr.funcs        = &fatfs_funcs;
     d->sr.sector_size  = geo->sector_size;
     d->sr.sector_count = full / geo->sector_size;
@@ -165,9 +202,9 @@ int frank_disc_mount(int drive, const char *path) {
 
     disc_close(drive);
     sdf_load_image(drive, geo, &d->sr);
-    printf("DISC: drive %d = '%s' (%s, %lu bytes, %lu sectors)\n",
+    printf("DISC: drive %d = '%s' (%s, %lu bytes, %lu sectors%s)\n",
            drive, path, geo->name, (unsigned long)fsize,
-           (unsigned long)d->sr.sector_count);
+           (unsigned long)d->sr.sector_count, d->writable ? "" : ", read only");
     return 0;
 }
 
