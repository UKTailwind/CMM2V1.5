                                                  uint32_t timeout_ms);
 typedef void (*sector_read_close_func)(struct sector_read *sector_read);
+/* CMM2: a sector written back to the image (data NULL: whether the image can be written); false if it cannot be */
+typedef bool (*sector_read_write_sector_func)(struct sector_read *sr, uint32_t sector, const uint8_t *data);
 
