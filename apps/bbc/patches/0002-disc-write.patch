+                    count++;
+                } else {
+                    b->buffer.bytes[offset] = (uint8_t)c;
+                    if (count == 0) {
+                        if (sector_read_write_sector(sr[sdf_drive], sr_sector_num[sdf_drive], b->buffer.bytes))
+                            fdc_finishread();
+                        else
+                            fdc_writeprotect();
