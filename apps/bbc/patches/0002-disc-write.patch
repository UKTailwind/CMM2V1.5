 #ifndef B_EM_PICO_SECTOR_READ_H
 #define B_EM_PICO_SECTOR_READ_H
 
+#include <stdbool.h>
 #include "pico/types.h"
 #include "pico/util/buffer.h"
 
@@ -35,6 +36,8 @@ typedef void (*sector_read_release_buffer_func)(struct sector_read *sr, struct s
