                 count = 500;
             }
 #else
-//            panic_unsupported();
-            fdc_writeprotect();
-            state = ST_IDLE;
+            // CMM2: each sector of the track written back blank
+            if (!sector_read_write_sector(sr[sdf_drive], sr_sector_num[sdf_drive], NULL)) {
+                fdc_writeprotect();
+                state = ST_IDLE;
+                break;
+            }
+            if (--count == 0) {
+                static const uint8_t blank[1024];
+                if (geometry[sdf_drive]->sector_size > sizeof(blank) ||
+                    !sector_read_write_sector(sr[sdf_drive], sr_sector_num[sdf_drive], blank)) {
+                    fdc_writeprotect();
+                    state = ST_IDLE;
+                    break;
+                }
+                if (++sdf_sector >= geometry[sdf_drive]->sectors_per_track) {
+                    state = ST_IDLE;
+                    fdc_finishread();
