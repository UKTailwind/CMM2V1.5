diff --git a/src/frank/frank_screenshot.c b/src/frank/frank_screenshot.c
index 1aaa242..7c433f1 100644
--- a/src/frank/frank_screenshot.c
+++ b/src/frank/frank_screenshot.c
@@ -59,7 +59,11 @@ int frank_screenshot_save(const uint8_t *fb) {
     f_mkdir("/micro/screenshot");
 
     const int W = MICRO_FB_WIDTH;   /* 320 */
+#ifdef CMM2_APP
+    const int H = MICRO_FB_HEIGHT * 2;  /* CMM2: each of the BBC's lines twice, as it is shown */
+#else
     const int H = MICRO_FB_HEIGHT;  /* 256 */
+#endif
     const int row_bytes = (W + 3) & ~3;
     const uint32_t palette_size    = 256 * 4;
     const uint32_t pixel_offset    = 14 + 40 + palette_size;
@@ -106,7 +110,11 @@ int frank_screenshot_save(const uint8_t *fb) {
     uint8_t row_pad[4] = {0, 0, 0, 0};
     int pad = row_bytes - W;
     for (int y = H - 1; y >= 0; y--) {
+#ifdef CMM2_APP
+        const uint8_t *src = fb + (size_t)(y / 2) * W;
+#else
         const uint8_t *src = fb + (size_t)y * W;
+#endif
         f_write(&f, src, (UINT)W, &bw);
         if (pad > 0)
             f_write(&f, row_pad, (UINT)pad, &bw);
