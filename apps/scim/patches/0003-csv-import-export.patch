+/* 1 if s is UTF-8: each sequence well formed */
+static int utf8_valid(const unsigned char * s) {
+    int n, k;
+    while (*s) {
+        if (*s < 0x80) { s++; continue; }
+        if (*s >= 0xC2 && *s <= 0xDF) n = 1;
+        else if (*s >= 0xE0 && *s <= 0xEF) n = 2;
+        else if (*s >= 0xF0 && *s <= 0xF4) n = 3;
+        else return 0;
+        for (k = 1; k <= n; k++)
+            if ((s[k] & 0xC0) != 0x80) return 0;
+        s += n + 1;
+    }
+    return 1;
+}
+
+/* in, in Windows-1252 (Excel's plain "CSV"), as UTF-8 in out: at most three bytes for each */
+static void cp1252_to_utf8(const char * in, char * out) {
+    static const unsigned short hi[32] = {     /* 0x80-0x9F; the five it leaves out as Latin-1 has them */
+        0x20AC, 0x0081, 0x201A, 0x0192, 0x201E, 0x2026, 0x2020, 0x2021,
+        0x02C6, 0x2030, 0x0160, 0x2039, 0x0152, 0x008D, 0x017D, 0x008F,
+        0x0090, 0x2018, 0x2019, 0x201C, 0x201D, 0x2022, 0x2013, 0x2014,
+        0x02DC, 0x2122, 0x0161, 0x203A, 0x0153, 0x009D, 0x017E, 0x0178 };
+    const unsigned char * s = (const unsigned char *) in;
+    unsigned char * o = (unsigned char *) out;
+    unsigned int u;
+    for (; *s; s++) {
+        u = (*s >= 0x80 && *s <= 0x9F) ? hi[*s - 0x80] : *s;
+        if (u < 0x80) *o++ = u;
+        else if (u < 0x800) { *o++ = 0xC0 | (u >> 6); *o++ = 0x80 | (u & 0x3F); }
+        else { *o++ = 0xE0 | (u >> 12); *o++ = 0x80 | ((u >> 6) & 0x3F); *o++ = 0x80 | (u & 0x3F); }
+    }
+    *o = '\0';
+}
