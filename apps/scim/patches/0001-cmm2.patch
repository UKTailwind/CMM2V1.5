+/**
+ * \brief The colour pair of ucolors[DEFAULT], numbered as ui_start_colors() makes them (by def, as
+ * ui_set_ucolor numbers them): wbkgd's pair was (fg+1) * COLORS + bg + 2, a pair never made (which ncurses's
+ * 8-bit pair field happened to take as pair 1; a curses with a wider field gave it no colours of its own)
+ * \return the pair
+ */
+int ui_default_pair(void) {
+    int def = 9;
+    if (COLORS > 8) def = 33;
+    return (ucolors[DEFAULT].fg+1)*def + ucolors[DEFAULT].bg + 2;
