+#if defined PDCURSES
+/* PDCurses (the CMM2's port, apps/pdcurses) gives Ctrl and Alt with the arrows and the editing keys codes of their
+ * own (CTL_LEFT, ALT_HOME...), not the terminfo names ncurses's keyname() gives, which dpy_getkeyname() decodes, and
+ * reports Shift, Ctrl and Alt by PDC_get_key_modifiers(): the same names, made from those. */
+static unsigned long key_modifiers;
+
+static const char* pdcurses_keyname(int k)
+{
+	enum { S = PDC_KEY_MODIFIER_SHIFT, A = PDC_KEY_MODIFIER_ALT, C = PDC_KEY_MODIFIER_CONTROL };
+	static const struct { int key; const char* name; int mods; } keys[] = {
+		{ KEY_UP, "UP", 0 }, { KEY_DOWN, "DOWN", 0 }, { KEY_LEFT, "LEFT", 0 }, { KEY_RIGHT, "RIGHT", 0 },
+		{ KEY_HOME, "HOME", 0 }, { KEY_END, "END", 0 }, { KEY_PPAGE, "PGUP", 0 }, { KEY_NPAGE, "PGDN", 0 },
+		{ KEY_IC, "INSERT", 0 }, { KEY_DC, "DELETE", 0 },
+		{ KEY_SR, "UP", S }, { KEY_SF, "DOWN", S }, { KEY_SLEFT, "LEFT", S }, { KEY_SRIGHT, "RIGHT", S },
+		{ KEY_SHOME, "HOME", S }, { KEY_SEND, "END", S }, { KEY_SPREVIOUS, "PGUP", S }, { KEY_SNEXT, "PGDN", S },
+		{ KEY_SIC, "INSERT", S }, { KEY_SDC, "DELETE", S },
+		{ CTL_UP, "UP", C }, { CTL_DOWN, "DOWN", C }, { CTL_LEFT, "LEFT", C }, { CTL_RIGHT, "RIGHT", C },
+		{ CTL_HOME, "HOME", C }, { CTL_END, "END", C }, { CTL_PGUP, "PGUP", C }, { CTL_PGDN, "PGDN", C },
+		{ CTL_INS, "INSERT", C }, { CTL_DEL, "DELETE", C }, { CTL_TAB, "TAB", C },
+		{ ALT_UP, "UP", A }, { ALT_DOWN, "DOWN", A }, { ALT_LEFT, "LEFT", A }, { ALT_RIGHT, "RIGHT", A },
+		{ ALT_HOME, "HOME", A }, { ALT_END, "END", A }, { ALT_PGUP, "PGUP", A }, { ALT_PGDN, "PGDN", A },
+		{ ALT_INS, "INSERT", A }, { ALT_DEL, "DELETE", A },
+	};
+	static char buffer[32];
+	unsigned i;
+
+	for (i = 0; i < sizeof(keys)/sizeof(*keys); i++)
+		if (keys[i].key == k)
+		{
+			int m = keys[i].mods | (int)(key_modifiers & (S|A|C));
+			if (!m)
+				return NULL; /* the plain key: dpy_getkeyname's own */
+			sprintf(buffer, "KEY_%s%s%s%s", (m & S) ? "S" : "", (m & A) ? "A" : "", (m & C) ? "^" : "",
+				keys[i].name);
+			return buffer;
+		}
+	return NULL;
+}
+#endif
+
 void dpy_init(const char* argv[])
 {
 }
