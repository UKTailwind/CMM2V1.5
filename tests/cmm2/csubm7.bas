' csubm7.bas - CSUBs built for the CMM2's Cortex-M7 by mmb2csub --target cmm2 (the PicoMite's user-tools, cb8453d): Mix and
' Loop1 are CSUBs, MixB and Loop1B the same routines interpreted; every answer must agree (bad 0)
Option Explicit
Dim integer k, bad = 0
Dim float x, r1, r2
Dim integer n
Dim float xs(5) = (0.5, -2.25, 3.75, 100.125, -0.001, 12345.678)
Dim integer ns(5) = (7, -1000003, 3000000000, 0, 42, -9876543210)
For k = 0 To 5
  x = xs(k) : n = ns(k)
  r1 = Mix(x, n) : r2 = MixB(x, n)
  Print "Mix"; k; " "; Str$(r1, 0, 6); " "; Str$(r2, 0, 6); " "; Choice(r1 = r2, "OK", "DIFFERENT")
  If r1 <> r2 Then bad = bad + 1
Next
Loop1 20000, r1 : Loop1B 20000, r2
Print "Loop1 "; Str$(r1, 0, 9); " "; Str$(r2, 0, 9); " "; Choice(r1 = r2, "OK", "DIFFERENT")
If r1 <> r2 Then bad = bad + 1
Print "bad"; bad
End

' --- mmb2csub: Mix is now the CSUB below (original in cst.bas.bak)

Function MixB(x, n%)
  Local a, b%, c
  a = x * 1.5 + Sin(x) * Cos(x) - Sqr(Abs(x)) / 3
  b% = n% * 1234567 + n% \ 7 - (n% Mod 13)
  c = Atan2(x, 2) + Abs(x) ^ 1.5 + Int(x * 10) - Fix(-x * 3)
  MixB = a + b% + c + Cint(x * 100.7)
End Function

' --- mmb2csub: Loop1 is now the CSUB below (original in cst.bas.bak)

Sub Loop1B(n%, r)
  Local i%
  r = 0
  For i% = 1 To n%
    r = r + Sqr(i%) / i%
  Next
End Sub

' --- mmb2csub: generated code for Mix
' The wrapper keeps the original name, so call sites are unchanged.
Function Mix(x!, n%)
  Local __r!
  MixK __r!, x!, n%
  Mix = __r!
End Function

